{
 "description": "Hand-made sessions for B-16. group: useful (something durable is stated or learned), nothing (no knowledge), trap (a plausible false extraction). Event shapes follow what capture stores: prompts, command or path summaries, Edit/patch diffs as -/+ lines, the final reply. expect: items a good extraction contains (a candidate matches when its kind is in kind_any and, for every group of terms, title+content contains one term of the group, case-insensitive). traps: what must not appear.",
 "sessions": [
  {
   "id": "u01-root-cause",
   "group": "useful",
   "title": "Bug fix whose cause is only in the final reply",
   "events": [
    {
     "id": "p1",
     "kind": "user_prompt",
     "text": "pytest fails in pager.py, please fix"
    },
    {
     "id": "b1",
     "kind": "tool_result_summary",
     "tool": "Bash",
     "text": "cat pager.py test_pager.py && uv run --with pytest pytest -q 2>&1 | tail -30"
    },
    {
     "id": "e1",
     "kind": "tool_result_summary",
     "tool": "Edit",
     "text": "/repo/pager.py\n- return total_items // per_page\n+ return -(-total_items // per_page)"
    },
    {
     "id": "b2",
     "kind": "tool_result_summary",
     "tool": "Bash",
     "text": "uv run --with pytest pytest -q 2>&1 | tail -5"
    },
    {
     "id": "a1",
     "kind": "assistant_message",
     "text": "Root cause: page_count used floor division, which drops a partial last page, so 21 items at 10 per page gave 2 pages. I switched to ceiling division and all 3 tests pass."
    },
    {
     "id": "end",
     "kind": "session_end"
    }
   ],
   "expect": [
    {
     "kind_any": [
      "gotcha",
      "fact",
      "decision"
     ],
     "terms": [
      [
       "floor",
       "//"
      ],
      [
       "partial",
       "last page",
       "ceiling"
      ]
     ],
     "note": "floor division drops the last partial page"
    }
   ],
   "traps": []
  },
